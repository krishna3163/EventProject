# EventHub Backend Environment Variables
# Set these via system env vars or .env file

# MongoDB connection (use auth URI for Docker or production)
MONGODB_URI=mongodb://localhost:27017/mydb

# Server port
SERVER_PORT=8080

# JWT secret (generate a strong base64-encoded key for production!)
JWT_SECRET=dGhpcyBpcyBhIHZlcnkgbG9uZyBzZWNyZXQga2V5IGZvciBqd3QgdG9rZW4gZ2VuZXJhdGlvbiB1c2luZyBobWFjIHNoYTI1Ng==
JWT_EXPIRATION=86400000

# Default admin credentials (created on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@eventhub.com

# JDoodle code execution API (get keys from jdoodle.com)
JDOODLE_CLIENT_ID=your_client_id
JDOODLE_CLIENT_SECRET=your_client_secret
JDOODLE_API_URL=https://api.jdoodle.com/v1/execute
